<Project Sdk="Microsoft.NET.Sdk">

	<PropertyGroup>
		<TargetFrameworks>net9.0-android;net9.0-ios;net9.0-maccatalyst</TargetFrameworks>
		<TargetFrameworks Condition="$([MSBuild]::IsOSPlatform('windows'))">$(TargetFrameworks);net9.0-windows10.0.19041.0</TargetFrameworks>
		<OutputType>Exe</OutputType>
		<RootNamespace>AsterEats</RootNamespace>
		<UseMaui>true</UseMaui>
		<SingleProject>true</SingleProject>
		<ImplicitUsings>enable</ImplicitUsings>
		<Nullable>enable</Nullable>

		<!-- App identity -->
		<ApplicationTitle>AsterEats</ApplicationTitle>
		<ApplicationId>com.omirantechnologies.astereats</ApplicationId>
		<ApplicationDisplayVersion>1.0</ApplicationDisplayVersion>
		<ApplicationVersion>1</ApplicationVersion>

		<!-- Minimum OS versions -->
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'ios'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">15.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'android'">24.0</SupportedOSPlatformVersion>
		<SupportedOSPlatformVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</SupportedOSPlatformVersion>
		<TargetPlatformMinVersion Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">10.0.17763.0</TargetPlatformMinVersion>
	</PropertyGroup>

	<!-- Windows-specific settings: WinUI bootstrap + Package.appxmanifest under Platforms\Windows -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<UseWinUI>true</UseWinUI>
		<EnableMsixTooling>true</EnableMsixTooling>
		<WindowsPackageType>MSIX</WindowsPackageType>
		<ApplicationManifest>Platforms\Windows\app.manifest</ApplicationManifest>
	</PropertyGroup>

	<ItemGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'windows'">
		<Manifest Include="$(ApplicationManifest)" />
	</ItemGroup>

	<!-- MacCatalyst-specific: points at the sandbox entitlements file under Platforms\MacCatalyst -->
	<PropertyGroup Condition="$([MSBuild]::GetTargetPlatformIdentifier('$(TargetFramework)')) == 'maccatalyst'">
		<CodesignEntitlements>Platforms\MacCatalyst\Entitlements.plist</CodesignEntitlements>
	</PropertyGroup>

	<ItemGroup>
		<!-- App Icon (AsterTrek primary colour as the icon background) -->
		<MauiIcon Include="Resources\Images\appicon.svg" ForegroundFile="Resources\Images\appicon_fg.svg" Color="#36ABAD" />

		<!-- Splash Screen -->
		<MauiSplashScreen Include="Resources\Images\splash.svg" Color="#36ABAD" BaseSize="128,128" />
		<MauiImage Include="Resources\Images\appicon_fg.svg" />
		<MauiImage Include="Resources\Images\food_delivery_rider.svg" />
		<MauiImage Include="Resources\Images\icon_delivery.svg" />
		<MauiImage Include="Resources\Images\icon_email.svg" />
		<MauiImage Include="Resources\Images\icon_google.svg" />

		<!-- In-app / bottom-nav vector icons only - deliberately NOT a wildcard
		     over the whole Images folder, because appicon.svg and splash.svg
		     are already claimed by MauiIcon/MauiSplashScreen above and would
		     otherwise be registered twice under the same output name. -->
		<MauiImage Include="Resources\Images\icon_home.svg" />
		<MauiImage Include="Resources\Images\icon_profile.svg" />
		<MauiImage Include="Resources\Images\icon_wallet.svg" />
		<MauiImage Include="Resources\Images\ordering_online_food.gif" />

		<!-- Custom Fonts - add .ttf files here later and register them in MauiProgram.cs -->
		<MauiFont Include="Resources\Fonts\*" />
	</ItemGroup>

	<ItemGroup>
	  <None Remove="Resources\Images\appicon_fg.svg" />
	  <None Remove="Resources\Images\food_delivery_rider.svg" />
	  <None Remove="Resources\Images\icon_delivery.svg" />
	  <None Remove="Resources\Images\icon_email.svg" />
	  <None Remove="Resources\Images\icon_google.svg" />
	  <None Remove="Resources\Images\icon_profile.svg" />
	  <None Remove="Resources\Images\icon_wallet.svg" />
	  <None Remove="Resources\Raw\OnlineFoodOrder.json" />
	</ItemGroup>

	<ItemGroup>
	  <MauiAsset Include="Resources\Raw\OnlineFoodOrder.json" />
	</ItemGroup>

	<ItemGroup>
		<PackageReference Include="FFImageLoading.Maui" Version="1.3.2" />
		<PackageReference Include="Microsoft.Maui.Controls" Version="9.0.82" />
		<PackageReference Include="Microsoft.Extensions.Logging.Debug" Version="9.0.0" />
		<PackageReference Include="SkiaSharp.Extended.UI.Maui" Version="3.0.0" />
	</ItemGroup>

	<ItemGroup>
	  <MauiXaml Update="Controls\FloatingGlassNavigation.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\ActiveDeliveryPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\DeliveriesPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\DeliveryRequestPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\EarningsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\NotificationsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\OrderDetailsPage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	  <MauiXaml Update="Views\ProfilePage.xaml">
	    <Generator>MSBuild:Compile</Generator>
	  </MauiXaml>
	</ItemGroup>

</Project>
