<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AsterEats.ViewModels"
             xmlns:controls="clr-namespace:AsterEats.Controls"
             x:Class="AsterEats.Views.ProfilePage"
             x:DataType="viewmodels:ProfileViewModel"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.NavBarIsVisible="False">

    <ContentPage.Resources>

        <!-- Page-specific: outline icon -->
        <Style x:Key="ProfileIconStyle" TargetType="Path">
            <Setter Property="Stroke" Value="#278E90" />
            <Setter Property="StrokeThickness" Value="1.8" />
            <Setter Property="StrokeLineCap" Value="Round" />
            <Setter Property="StrokeLineJoin" Value="Round" />
            <Setter Property="Aspect" Value="Uniform" />
            <Setter Property="WidthRequest" Value="20" />
            <Setter Property="HeightRequest" Value="20" />
            <Setter Property="HorizontalOptions" Value="Center" />
            <Setter Property="VerticalOptions" Value="Center" />
        </Style>

        <!-- Page-specific: soft icon chip -->
        <Style x:Key="ProfileChipStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="#E8F5F5" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="Padding" Value="0" />
            <Setter Property="WidthRequest" Value="42" />
            <Setter Property="HeightRequest" Value="42" />
            <Setter Property="VerticalOptions" Value="Center" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="14" />
                </Setter.Value>
            </Setter>
        </Style>

        <!-- Page-specific: borderless card with soft shadow -->
        <Style x:Key="ProfileCardStyle" TargetType="Border">
            <Setter Property="BackgroundColor" Value="{StaticResource SurfaceColor}" />
            <Setter Property="StrokeThickness" Value="0" />
            <Setter Property="StrokeShape">
                <Setter.Value>
                    <RoundRectangle CornerRadius="20" />
                </Setter.Value>
            </Setter>
            <Setter Property="Shadow">
                <Setter.Value>
                    <Shadow Brush="#278E90"
                            Opacity="0.12"
                            Radius="18"
                            Offset="0,6" />
                </Setter.Value>
            </Setter>
        </Style>

    </ContentPage.Resources>

    <Grid>
        <ScrollView>

            <VerticalStackLayout Spacing="0"
                                 Padding="0,0,0,130">

                <!-- ============ HEADER ============ -->
                <Border StrokeThickness="0"
                        Padding="20,52,20,64">
                    <Border.Background>
                        <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                            <GradientStop Color="#278E90" Offset="0.0" />
                            <GradientStop Color="#36ABAD" Offset="1.0" />
                        </LinearGradientBrush>
                    </Border.Background>
                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="0,0,36,36" />
                    </Border.StrokeShape>

                    <Grid>

                        <!-- Decorative circles -->
                        <Ellipse WidthRequest="170"
                                 HeightRequest="170"
                                 Fill="#14FFFFFF"
                                 HorizontalOptions="End"
                                 VerticalOptions="Start"
                                 Margin="0,-90,-90,0" />

                        <Ellipse WidthRequest="120"
                                 HeightRequest="120"
                                 Fill="#0FFFFFFF"
                                 HorizontalOptions="Start"
                                 VerticalOptions="End"
                                 Margin="-60,0,0,-70" />

                        <VerticalStackLayout Spacing="8">

                            <Label Text="Profile"
                                   Style="{StaticResource ScreenTitleStyle}"
                                   TextColor="White"
                                   HorizontalTextAlignment="Center" />

                            <!-- Avatar with translucent ring -->
                            <Border WidthRequest="104"
                                    HeightRequest="104"
                                    Padding="6"
                                    Margin="0,8,0,0"
                                    HorizontalOptions="Center"
                                    BackgroundColor="#33FFFFFF"
                                    StrokeThickness="0">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="52" />
                                </Border.StrokeShape>

                                <Border BackgroundColor="White"
                                        StrokeThickness="0"
                                        Padding="0">
                                    <Border.StrokeShape>
                                        <RoundRectangle CornerRadius="46" />
                                    </Border.StrokeShape>

                                    <Path Data="M12,11 A4,4 0 1 1 12,3 A4,4 0 1 1 12,11 Z M4,21 C4,17 8,15 12,15 C16,15 20,17 20,21"
                                          Stroke="#36ABAD"
                                          StrokeThickness="1.5"
                                          StrokeLineCap="Round"
                                          StrokeLineJoin="Round"
                                          Aspect="Uniform"
                                          WidthRequest="44"
                                          HeightRequest="44"
                                          HorizontalOptions="Center"
                                          VerticalOptions="Center" />
                                </Border>
                            </Border>

                            <Label Text="{Binding Rider.Name}"
                                   FontSize="22"
                                   FontAttributes="Bold"
                                   TextColor="White"
                                   Margin="0,6,0,0"
                                   HorizontalTextAlignment="Center" />

                            <Label Text="{Binding Rider.Phone}"
                                   FontSize="13"
                                   TextColor="#DDF3F3"
                                   HorizontalTextAlignment="Center" />

                            <!-- Frosted vehicle pill -->
                            <Border HorizontalOptions="Center"
                                    Margin="0,6,0,0"
                                    BackgroundColor="#33FFFFFF"
                                    Stroke="#55FFFFFF"
                                    StrokeThickness="1"
                                    Padding="16,7">
                                <Border.StrokeShape>
                                    <RoundRectangle CornerRadius="16" />
                                </Border.StrokeShape>

                                <Label Text="{Binding Rider.VehicleType}"
                                       FontSize="12"
                                       FontAttributes="Bold"
                                       TextColor="White"
                                       CharacterSpacing="0.6"
                                       HorizontalTextAlignment="Center" />
                            </Border>

                        </VerticalStackLayout>

                    </Grid>
                </Border>

                <!-- ============ STAT CARDS (overlap header) ============ -->
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="14"
                      Margin="20,-36,20,0">

                    <!-- Rating -->
                    <Border Grid.Column="0"
                            Style="{StaticResource ProfileCardStyle}"
                            Padding="16">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">

                            <Border Style="{StaticResource ProfileChipStyle}">
                                <Path Data="M12,3 L14.6,9 L21,9.6 L16.2,13.8 L17.6,20 L12,16.8 L6.4,20 L7.8,13.8 L3,9.6 L9.4,9 Z"
                                      Style="{StaticResource ProfileIconStyle}"
                                      Fill="#36ABAD" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="1">
                                <Label Text="{Binding Rider.Rating, StringFormat='{0:0.0}'}"
                                       Style="{StaticResource StatValueStyle}" />
                                <Label Text="Rating"
                                       Style="{StaticResource CaptionLabelStyle}" />
                            </VerticalStackLayout>

                        </Grid>
                    </Border>

                    <!-- Completed -->
                    <Border Grid.Column="1"
                            Style="{StaticResource ProfileCardStyle}"
                            Padding="16">
                        <Grid ColumnDefinitions="Auto,*"
                              ColumnSpacing="12">

                            <Border Style="{StaticResource ProfileChipStyle}">
                                <Path Data="M12,3 A9,9 0 1 1 12,21 A9,9 0 1 1 12,3 Z M8,12 L11,15 L16,9"
                                      Style="{StaticResource ProfileIconStyle}" />
                            </Border>

                            <VerticalStackLayout Grid.Column="1"
                                                 VerticalOptions="Center"
                                                 Spacing="1">
                                <Label Text="{Binding Rider.CompletedDeliveries}"
                                       Style="{StaticResource StatValueStyle}" />
                                <Label Text="Completed"
                                       Style="{StaticResource CaptionLabelStyle}" />
                            </VerticalStackLayout>

                        </Grid>
                    </Border>

                </Grid>

                <!-- ============ ACCOUNT ============ -->
                <VerticalStackLayout Spacing="12"
                                     Margin="20,22,20,-10">

                    <Label Text="ACCOUNT"
                           FontSize="12"
                           FontAttributes="Bold"
                           CharacterSpacing="1.4"
                           TextColor="{StaticResource TextMuted}"
                           Margin="4,0,0,0" />

                    <Border Style="{StaticResource ProfileCardStyle}"
                            Padding="18,4">
                        <VerticalStackLayout Spacing="0">

                            <!-- Name -->
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="14"
                                  Padding="0,14">
                                <Border Style="{StaticResource ProfileChipStyle}">
                                    <Path Data="M12,11 A4,4 0 1 1 12,3 A4,4 0 1 1 12,11 Z M4,21 C4,17 8,15 12,15 C16,15 20,17 20,21"
                                          Style="{StaticResource ProfileIconStyle}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="2">
                                    <Label Text="Full Name"
                                           Style="{StaticResource CaptionLabelStyle}" />
                                    <Label Text="{Binding Rider.Name}"
                                           Style="{StaticResource BodyLabelStyle}"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Margin="56,0,0,0"
                                     Color="{StaticResource BorderColor}" />

                            <!-- Phone -->
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="14"
                                  Padding="0,14">
                                <Border Style="{StaticResource ProfileChipStyle}">
                                    <Path Data="M5,4 L9,4 L11,9 L8.5,10.5 C9.6,12.7 11.3,14.4 13.5,15.5 L15,13 L20,15 L20,19 C20,20 19,21 18,21 C10.8,20.6 3.4,13.2 3,6 C3,5 4,4 5,4 Z"
                                          Style="{StaticResource ProfileIconStyle}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="2">
                                    <Label Text="Phone"
                                           Style="{StaticResource CaptionLabelStyle}" />
                                    <Label Text="{Binding Rider.Phone}"
                                           Style="{StaticResource BodyLabelStyle}"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Margin="56,0,0,0"
                                     Color="{StaticResource BorderColor}" />

                            <!-- Email -->
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="14"
                                  Padding="0,14">
                                <Border Style="{StaticResource ProfileChipStyle}">
                                    <Path Data="M3,6 L21,6 L21,18 L3,18 Z M3,6 L12,13 L21,6"
                                          Style="{StaticResource ProfileIconStyle}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="2">
                                    <Label Text="Email"
                                           Style="{StaticResource CaptionLabelStyle}" />
                                    <Label Text="{Binding Rider.Email}"
                                           Style="{StaticResource BodyLabelStyle}"
                                           FontAttributes="Bold"
                                           LineBreakMode="TailTruncation" />
                                </VerticalStackLayout>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

                <!-- ============ VEHICLE ============ -->
                <VerticalStackLayout Spacing="12"
                                     Margin="20,24,20,0">

                    <Label Text="VEHICLE"
                           FontSize="12"
                           FontAttributes="Bold"
                           CharacterSpacing="1.4"
                           TextColor="{StaticResource TextMuted}"
                           Margin="4,0,0,0" />

                    <Border Style="{StaticResource ProfileCardStyle}"
                            Padding="18,4">
                        <VerticalStackLayout Spacing="0">

                            <!-- Vehicle type -->
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="14"
                                  Padding="0,14">
                                <Border Style="{StaticResource ProfileChipStyle}">
                                    <Path Data="M5,16 L5,11 L7,6 L17,6 L19,11 L19,16 Z M3,16 L21,16 M7,19 L7,16 M17,19 L17,16"
                                          Style="{StaticResource ProfileIconStyle}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="2">
                                    <Label Text="Vehicle Type"
                                           Style="{StaticResource CaptionLabelStyle}" />
                                    <Label Text="{Binding Rider.VehicleType}"
                                           Style="{StaticResource BodyLabelStyle}"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Grid>

                            <BoxView HeightRequest="1"
                                     Margin="56,0,0,0"
                                     Color="{StaticResource BorderColor}" />

                            <!-- Registration -->
                            <Grid ColumnDefinitions="Auto,*"
                                  ColumnSpacing="14"
                                  Padding="0,14">
                                <Border Style="{StaticResource ProfileChipStyle}">
                                    <Path Data="M3,7 L21,7 L21,17 L3,17 Z M7,11 L17,11 M7,14 L13,14"
                                          Style="{StaticResource ProfileIconStyle}" />
                                </Border>
                                <VerticalStackLayout Grid.Column="1"
                                                     VerticalOptions="Center"
                                                     Spacing="2">
                                    <Label Text="Registration Number"
                                           Style="{StaticResource CaptionLabelStyle}" />
                                    <Label Text="{Binding Rider.VehicleNumber}"
                                           Style="{StaticResource BodyLabelStyle}"
                                           FontAttributes="Bold" />
                                </VerticalStackLayout>
                            </Grid>

                        </VerticalStackLayout>
                    </Border>

                </VerticalStackLayout>

            </VerticalStackLayout>

        </ScrollView>

        <controls:FloatingGlassNavigation
            VerticalOptions="End"
            HorizontalOptions="Fill" 
            Margin="0,0,0,30"/>
    </Grid>

</ContentPage>