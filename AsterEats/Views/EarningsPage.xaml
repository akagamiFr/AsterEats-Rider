<?xml version="1.0" encoding="utf-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AsterEats.ViewModels"
             xmlns:controls="clr-namespace:AsterEats.Controls"
             xmlns:models="clr-namespace:AsterEats.Models"
             x:Class="AsterEats.Views.EarningsPage"
             x:DataType="viewmodels:EarningsViewModel"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.NavBarIsVisible="False">

    <Grid>

        <ScrollView>

            <VerticalStackLayout
                Padding="20,22,20,110"
                Spacing="16">

                <!-- ================= HEADER ================= -->

                <VerticalStackLayout Spacing="3">

                    <Label Text="Earnings"
                           Style="{StaticResource ScreenTitleStyle}"
                           TextColor="{StaticResource PrimaryColor}" 
                           Margin="0,30,0,0"/>

                    <Label Text="Track your delivery income"
                           Style="{StaticResource CaptionLabelStyle}" />

                </VerticalStackLayout>


                <!-- ================= TOTAL EARNINGS ================= -->

                <Frame Style="{StaticResource CardFrameStyle}"
                       Padding="18">

                    <Grid ColumnDefinitions="*,Auto"
                          ColumnSpacing="14">

                        <!-- Earnings Content -->
                        <VerticalStackLayout
                            Grid.Column="0"
                            Spacing="5">

                            <Label Text="TOTAL EARNINGS"
                                   Style="{StaticResource CaptionLabelStyle}"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding TotalEarnings, StringFormat='৳{0:0}'}"
                                   FontSize="36"
                                   FontAttributes="Bold"
                                   TextColor="{StaticResource PrimaryDarkColor}" />

                            <Label Text="From completed deliveries"
                                   Style="{StaticResource MutedLabelStyle}" />

                        </VerticalStackLayout>


                        <!-- Wallet Icon -->
                        <Border Grid.Column="1"
                                WidthRequest="64"
                                HeightRequest="64"
                                BackgroundColor="#1036ABAD"
                                StrokeThickness="0"
                                StrokeShape="RoundRectangle 20"
                                Padding="11"
                                VerticalOptions="Center">

                            <Image Source="icon_wallet.svg"
                                   WidthRequest="42"
                                   HeightRequest="42"
                                   Aspect="AspectFit"
                                   HorizontalOptions="Center"
                                   VerticalOptions="Center" />

                        </Border>

                    </Grid>

                </Frame>


                <!-- ================= SMALL STAT CARDS ================= -->

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <!-- Today -->
                    <Frame Grid.Column="0"
                           Style="{StaticResource CardFrameStyle}"
                           Padding="16">

                        <VerticalStackLayout Spacing="5">

                            <Label Text="TODAY"
                                   Style="{StaticResource CaptionLabelStyle}"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding TodayEarnings, StringFormat='৳{0:0}'}"
                                   Style="{StaticResource StatValueStyle}" />

                            <Label Text="Earnings"
                                   Style="{StaticResource MutedLabelStyle}" />

                        </VerticalStackLayout>

                    </Frame>


                    <!-- Deliveries -->
                    <Frame Grid.Column="1"
                           Style="{StaticResource CardFrameStyle}"
                           Padding="16">

                        <VerticalStackLayout Spacing="5">

                            <Label Text="DELIVERIES"
                                   Style="{StaticResource CaptionLabelStyle}"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding TodayDeliveries}"
                                   Style="{StaticResource StatValueStyle}" />

                            <Label Text="Completed today"
                                   Style="{StaticResource MutedLabelStyle}" />

                        </VerticalStackLayout>

                    </Frame>

                </Grid>


                <!-- ================= EARNINGS OVERVIEW ================= -->

                <Frame Style="{StaticResource CardFrameStyle}"
                       Padding="16">

                    <VerticalStackLayout Spacing="12">

                        <!-- Chart Header -->
                        <Grid ColumnDefinitions="*,Auto">

                            <VerticalStackLayout
                                Grid.Column="0"
                                Spacing="2">

                                <Label Text="Earnings Overview"
                                       Style="{StaticResource SectionTitleStyle}" />

                                <Label Text="This week"
                                       Style="{StaticResource CaptionLabelStyle}" />

                            </VerticalStackLayout>


                            <!-- Weekly Total -->
                            <VerticalStackLayout
                                Grid.Column="1"
                                HorizontalOptions="End"
                                Spacing="1">

                                <Label Text="WEEK"
                                       FontSize="10"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource TextMuted}"
                                       HorizontalTextAlignment="End" />

                                <Label Text="{Binding WeeklyEarningsTotal, StringFormat='৳{0:0}'}"
                                       FontSize="16"
                                       FontAttributes="Bold"
                                       TextColor="{StaticResource PrimaryDarkColor}"
                                       HorizontalTextAlignment="End" />

                            </VerticalStackLayout>

                        </Grid>


                        <!-- Chart -->
                        <CollectionView
                            ItemsSource="{Binding WeeklyEarnings}"
                            SelectionMode="None"
                            HeightRequest="165"
                            HorizontalScrollBarVisibility="Never"
                            VerticalScrollBarVisibility="Never">

                            <CollectionView.ItemsLayout>
                                <LinearItemsLayout
                                    Orientation="Horizontal"
                                    ItemSpacing="9" />
                            </CollectionView.ItemsLayout>

                            <CollectionView.ItemTemplate>

                                <DataTemplate
                                    x:DataType="models:WeeklyEarningPoint">

                                    <Grid WidthRequest="36"
                                          HeightRequest="155"
                                          RowDefinitions="125,30">

                                        <!-- Bar Area -->
                                        <Grid Grid.Row="0"
                                              VerticalOptions="End">

                                            <Border
                                                HeightRequest="{Binding BarHeight}"
                                                WidthRequest="18"
                                                BackgroundColor="{StaticResource PrimaryColor}"
                                                StrokeThickness="0"
                                                StrokeShape="RoundRectangle 9"
                                                HorizontalOptions="Center"
                                                VerticalOptions="End" />

                                        </Grid>


                                        <!-- Day -->
                                        <Label Grid.Row="1"
                                               Text="{Binding DayLabel}"
                                               FontSize="11"
                                               TextColor="{StaticResource TextSecondary}"
                                               HorizontalTextAlignment="Center"
                                               VerticalTextAlignment="Center" />

                                    </Grid>

                                </DataTemplate>

                            </CollectionView.ItemTemplate>

                        </CollectionView>

                    </VerticalStackLayout>

                </Frame>


                <!-- ================= PERFORMANCE ================= -->

                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="12">

                    <!-- Weekly -->
                    <Frame Grid.Column="0"
                           Style="{StaticResource CardFrameStyle}"
                           Padding="16">

                        <VerticalStackLayout Spacing="5">

                            <Label Text="WEEKLY"
                                   Style="{StaticResource CaptionLabelStyle}"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding WeeklyEarningsTotal, StringFormat='৳{0:0}'}"
                                   Style="{StaticResource StatValueStyle}"
                                   FontSize="20" />

                            <Label Text="Total this week"
                                   Style="{StaticResource MutedLabelStyle}" />

                        </VerticalStackLayout>

                    </Frame>


                    <!-- Average -->
                    <Frame Grid.Column="1"
                           Style="{StaticResource CardFrameStyle}"
                           Padding="16">

                        <VerticalStackLayout Spacing="5">

                            <Label Text="AVERAGE"
                                   Style="{StaticResource CaptionLabelStyle}"
                                   FontAttributes="Bold" />

                            <Label Text="{Binding AveragePerDelivery, StringFormat='৳{0:0}'}"
                                   Style="{StaticResource StatValueStyle}"
                                   FontSize="20" />

                            <Label Text="Per delivery"
                                   Style="{StaticResource MutedLabelStyle}" />

                        </VerticalStackLayout>

                    </Frame>

                </Grid>


                <!-- ================= RECENT EARNINGS ================= -->

                <Grid ColumnDefinitions="*,Auto">

                    <Label Grid.Column="0"
           Text="Recent Earnings"
           Style="{StaticResource SectionTitleStyle}" />

                    <Label Grid.Column="1"
           Text="Latest"
           FontSize="12"
           FontAttributes="Bold"
           TextColor="{StaticResource PrimaryColor}"
           VerticalOptions="Center" />

                </Grid>

                <Label Text="No recent earnings yet"
       Style="{StaticResource MutedLabelStyle}"
       HorizontalTextAlignment="Center"
       Margin="0,6,0,2"
       IsVisible="{Binding HasRecentEarnings, Converter={StaticResource InverseBoolConverter}}" />

                <CollectionView
    ItemsSource="{Binding RecentEarnings}"
    SelectionMode="None"
    ItemsLayout="VerticalList"
    VerticalScrollBarVisibility="Never">

                    <CollectionView.ItemTemplate>

                        <DataTemplate
            x:DataType="models:Earning">

                            <Frame Style="{StaticResource CardFrameStyle}"
                   Margin="0,4"
                   Padding="14">

                                <Grid ColumnDefinitions="*,Auto"
                      RowDefinitions="Auto,Auto"
                      RowSpacing="4">

                                    <Label Grid.Row="0"
                           Grid.Column="0"
                           Text="{Binding RestaurantName}"
                           Style="{StaticResource BodyLabelStyle}"
                           FontAttributes="Bold" />

                                    <Label Grid.Row="0"
                           Grid.Column="1"
                           Text="{Binding Amount, StringFormat='+৳{0:0}'}"
                           TextColor="{StaticResource SuccessColor}"
                           FontAttributes="Bold"
                           HorizontalTextAlignment="End" />

                                    <Label Grid.Row="1"
                           Grid.Column="0"
                           Text="{Binding AreaLabel}"
                           Style="{StaticResource CaptionLabelStyle}" />

                                    <Label Grid.Row="1"
                           Grid.Column="1"
                           Text="{Binding DateUtc, StringFormat='{0:dd MMM, hh:mm tt}'}"
                           Style="{StaticResource MutedLabelStyle}"
                           HorizontalTextAlignment="End" />

                                </Grid>

                            </Frame>

                        </DataTemplate>

                    </CollectionView.ItemTemplate>

                </CollectionView>

            </VerticalStackLayout>

        </ScrollView>


        <!-- ================= FLOATING NAVIGATION ================= -->

        <controls:FloatingGlassNavigation
            VerticalOptions="End"
            HorizontalOptions="Fill"
            Margin="0,0,0,30"/>

    </Grid>

</ContentPage>