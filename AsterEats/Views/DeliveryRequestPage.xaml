<?xml version="1.0" encoding="UTF-8" ?>

<ContentView xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             x:Class="AsterEats.Views.DeliveryRequestPage"
             IsVisible="False">

    <Grid RowDefinitions="*,Auto">

        <!-- Dimmed Home Background -->
        <BoxView Grid.RowSpan="2"
                 Color="#66000000" />

        <!-- Bottom Sheet -->
        <Border x:Name="BottomSheet"
                Grid.Row="1"
                BackgroundColor="{StaticResource AppBackground}"
                StrokeThickness="0"
                Padding="20,20,20,24"
                TranslationY="700">

            <Border.StrokeShape>
                <RoundRectangle CornerRadius="26,26,0,0" />
            </Border.StrokeShape>

            <Border.GestureRecognizers>
                <PanGestureRecognizer
                    PanUpdated="OnBottomSheetPanUpdated" />
            </Border.GestureRecognizers>

            <VerticalStackLayout Spacing="14">

                <!-- Handle -->
                <BoxView WidthRequest="44"
                         HeightRequest="5"
                         CornerRadius="3"
                         Color="#C9D0D0"
                         HorizontalOptions="Center" />

                <!-- Header -->
                <Grid ColumnDefinitions="*,Auto"
                      ColumnSpacing="10">

                    <VerticalStackLayout Spacing="2">

                        <Label Text="New Delivery Request"
                               Style="{StaticResource ScreenTitleStyle}" />

                        <Label Text="A new order is available"
                               Style="{StaticResource CaptionLabelStyle}" />

                    </VerticalStackLayout>

                    <Border Grid.Column="1"
                            BackgroundColor="#E8F7F7"
                            StrokeThickness="0"
                            Padding="10,6"
                            VerticalOptions="Center">

                        <Border.StrokeShape>
                            <RoundRectangle CornerRadius="12" />
                        </Border.StrokeShape>

                        <Label Text="{Binding Delivery.DistanceKm, StringFormat='{0:0.0} km'}"
                               TextColor="{StaticResource PrimaryDarkColor}"
                               FontAttributes="Bold"
                               FontSize="12" />

                    </Border>

                </Grid>


                <!-- Pickup -->
                <Border BackgroundColor="White"
                        Stroke="#E3E8E8"
                        StrokeThickness="1"
                        Padding="13">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="4">

                        <Label Text="PICKUP"
                               Style="{StaticResource CaptionLabelStyle}"
                               TextColor="{StaticResource PrimaryDarkColor}"
                               FontAttributes="Bold"
                               FontSize="11" />

                        <Label Text="{Binding Delivery.Restaurant.Name}"
                               Style="{StaticResource SectionTitleStyle}"
                               FontSize="15" />

                        <Label Text="{Binding Delivery.Restaurant.Address}"
                               Style="{StaticResource BodyLabelStyle}"
                               FontSize="14"
                               LineBreakMode="TailTruncation" />

                    </VerticalStackLayout>

                </Border>


                <!-- Drop-off -->
                <Border BackgroundColor="White"
                        Stroke="#E3E8E8"
                        StrokeThickness="1"
                        Padding="13">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="4">

                        <Label Text="DROP-OFF"
                               Style="{StaticResource CaptionLabelStyle}"
                               TextColor="{StaticResource PrimaryDarkColor}"
                               FontAttributes="Bold"
                               FontSize="11" />

                        <Label Text="{Binding Delivery.CustomerName}"
                               Style="{StaticResource SectionTitleStyle}"
                               FontSize="15" />

                        <Label Text="{Binding Delivery.DeliveryAddress}"
                               Style="{StaticResource BodyLabelStyle}"
                               FontSize="14"
                               LineBreakMode="TailTruncation" />

                    </VerticalStackLayout>

                </Border>


                <!-- Earnings -->
                <Grid ColumnDefinitions="*,Auto"
                      Padding="2,0">

                    <VerticalStackLayout Grid.Column="0"
                                         Spacing="2">

                        <Label Text="Delivery Fee"
                               Style="{StaticResource CaptionLabelStyle}" />

                        <Label Text="{Binding Delivery.DeliveryFee, StringFormat='৳{0:0}'}"
                               Style="{StaticResource StatValueStyle}"
                               TextColor="{StaticResource PrimaryDarkColor}" />

                    </VerticalStackLayout>

                    <VerticalStackLayout Grid.Column="1"
                                         HorizontalOptions="End"
                                         Spacing="2">

                        <Label Text="Payment"
                               Style="{StaticResource CaptionLabelStyle}" />

                        <Label Text="{Binding Delivery.PaymentMethod}"
                               Style="{StaticResource BodyLabelStyle}"
                               FontAttributes="Bold" />

                    </VerticalStackLayout>

                </Grid>


                <!-- Actions -->
                <Grid ColumnDefinitions="*,*"
                      ColumnSpacing="10">

                    <Button Grid.Column="0"
                            Text="REJECT"
                            BackgroundColor="Transparent"
                            BorderColor="#D75B5B"
                            BorderWidth="1"
                            TextColor="#B43F3F"
                            HeightRequest="46"
                            CornerRadius="14"
                            Clicked="OnRejectClicked" />

                    <Button Grid.Column="1"
                            Text="ACCEPT"
                            Style="{StaticResource PrimaryButtonStyle}"
                            HeightRequest="46"
                            CornerRadius="14"
                            Clicked="OnAcceptClicked" />

                </Grid>

            </VerticalStackLayout>

        </Border>

    </Grid>

</ContentView>