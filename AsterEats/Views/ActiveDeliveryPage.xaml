<?xml version="1.0" encoding="UTF-8" ?>

<ContentPage xmlns="http://schemas.microsoft.com/dotnet/2021/maui"
             xmlns:x="http://schemas.microsoft.com/winfx/2009/xaml"
             xmlns:viewmodels="clr-namespace:AsterEats.ViewModels"
             x:Class="AsterEats.Views.ActiveDeliveryPage"
             x:DataType="viewmodels:ActiveDeliveryViewModel"
             BackgroundColor="{StaticResource AppBackground}"
             Shell.NavBarIsVisible="False">

    <Grid RowDefinitions="Auto,*,Auto">

        <!-- ==================== HEADER ==================== -->

        <Grid Grid.Row="0"
              Padding="18,10,18,6"
              ColumnDefinitions="*,Auto"
              ColumnSpacing="10">

            <VerticalStackLayout Spacing="2">

                <Label Text="Active Delivery"
                       Style="{StaticResource ScreenTitleStyle}"
                        Margin="0,40,0,0"/>

                <Label Text="{Binding Delivery.Restaurant.Name}"
                       Style="{StaticResource CaptionLabelStyle}" />

            </VerticalStackLayout>

            <Border Grid.Column="1"
                    BackgroundColor="#E8F7F7"
                    StrokeThickness="0"
                    Padding="10,6"
                    VerticalOptions="Center">

                <Border.StrokeShape>
                    <RoundRectangle CornerRadius="12" />
                </Border.StrokeShape>

                <Label Text="{Binding Delivery.StatusText}"
                       TextColor="{StaticResource PrimaryDarkColor}"
                       FontAttributes="Bold"
                       FontSize="11" />

            </Border>

        </Grid>


        <!-- ==================== DELIVERY CONTENT ==================== -->

        <ScrollView Grid.Row="1">

            <VerticalStackLayout Padding="16,8,16,16"
                                 Spacing="10">

                <!-- Status -->
                <Border BackgroundColor="{StaticResource PrimaryColor}"
                        StrokeThickness="0"
                        Padding="16">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="18" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="5">

                        <Label Text="DELIVERY STATUS"
                               TextColor="White"
                               FontSize="11"
                               FontAttributes="Bold"
                               Opacity="0.8" />

                        <Label Text="{Binding StatusTitle}"
                               TextColor="White"
                               FontSize="24"
                               FontAttributes="Bold" />

                        <Label Text="{Binding StatusDescription}"
                               TextColor="White"
                               FontSize="13"
                               LineBreakMode="WordWrap"
                               Opacity="0.95" />

                    </VerticalStackLayout>

                </Border>


                <!-- Restaurant -->
                <Border BackgroundColor="White"
                        Stroke="#E3E8E8"
                        StrokeThickness="1"
                        Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="4">

                        <Label Text="PICKUP"
                               Style="{StaticResource CaptionLabelStyle}"
                               TextColor="{StaticResource PrimaryDarkColor}"
                               FontAttributes="Bold"
                               FontSize="11" />

                        <Label Text="{Binding Delivery.Restaurant.Name}"
                               Style="{StaticResource SectionTitleStyle}"
                               FontSize="15" />

                        <Label Text="{Binding Delivery.Restaurant.Address}"
                               Style="{StaticResource BodyLabelStyle}"
                               FontSize="14"
                               LineBreakMode="TailTruncation" />

                        <Label Text="{Binding Delivery.Restaurant.Phone}"
                               Style="{StaticResource CaptionLabelStyle}"
                               FontSize="12" />

                    </VerticalStackLayout>

                </Border>


                <!-- Customer -->
                <Border BackgroundColor="White"
                        Stroke="#E3E8E8"
                        StrokeThickness="1"
                        Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <VerticalStackLayout Spacing="4">

                        <Label Text="DROP-OFF"
                               Style="{StaticResource CaptionLabelStyle}"
                               TextColor="{StaticResource PrimaryDarkColor}"
                               FontAttributes="Bold"
                               FontSize="11" />

                        <Label Text="{Binding Delivery.CustomerName}"
                               Style="{StaticResource SectionTitleStyle}"
                               FontSize="15" />

                        <Label Text="{Binding Delivery.CustomerPhone}"
                               Style="{StaticResource BodyLabelStyle}"
                               FontSize="14" />

                        <Label Text="{Binding Delivery.DeliveryAddress}"
                               Style="{StaticResource CaptionLabelStyle}"
                               FontSize="12"
                               LineBreakMode="TailTruncation" />

                    </VerticalStackLayout>

                </Border>


                <!-- Delivery Summary -->
                <Border BackgroundColor="White"
                        Stroke="#E3E8E8"
                        StrokeThickness="1"
                        Padding="14">

                    <Border.StrokeShape>
                        <RoundRectangle CornerRadius="16" />
                    </Border.StrokeShape>

                    <Grid ColumnDefinitions="*,*,*"
                          ColumnSpacing="8">

                        <VerticalStackLayout Spacing="2">

                            <Label Text="DISTANCE"
                                   Style="{StaticResource CaptionLabelStyle}"
                                   FontSize="10" />

                            <Label Text="{Binding Delivery.DistanceKm, StringFormat='{0:0.0} km'}"
                                   Style="{StaticResource BodyLabelStyle}"
                                   FontAttributes="Bold"
                                   FontSize="14" />

                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="1"
                                             Spacing="2">

                            <Label Text="ORDER"
                                   Style="{StaticResource CaptionLabelStyle}"
                                   FontSize="10" />

                            <Label Text="{Binding Delivery.OrderAmount, StringFormat='৳{0:0}'}"
                                   Style="{StaticResource BodyLabelStyle}"
                                   FontAttributes="Bold"
                                   FontSize="14" />

                        </VerticalStackLayout>

                        <VerticalStackLayout Grid.Column="2"
                                             Spacing="2">

                            <Label Text="FEE"
                                   Style="{StaticResource CaptionLabelStyle}"
                                   FontSize="10" />

                            <Label Text="{Binding Delivery.DeliveryFee, StringFormat='৳{0:0}'}"
                                   Style="{StaticResource BodyLabelStyle}"
                                   FontAttributes="Bold"
                                   FontSize="14"
                                   TextColor="{StaticResource PrimaryDarkColor}" />

                        </VerticalStackLayout>

                    </Grid>

                </Border>

            </VerticalStackLayout>

        </ScrollView>


        <!-- ==================== ACTION ==================== -->

        <Border Grid.Row="2"
                BackgroundColor="White"
                StrokeThickness="0"
                Padding="18,10,18,50">

            <Button Text="{Binding ActionButtonText}"
                    Command="{Binding ActionCommand}"
                    Style="{StaticResource PrimaryButtonStyle}"
                    HeightRequest="48" />

        </Border>

    </Grid>

</ContentPage>